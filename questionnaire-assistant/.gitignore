node_modules/

# Secrets — never commit
.env
.env.*
.anthropic_key
*.key
*.pem

# Private working notes, kept out of the repo. Deleting a committed file does not
# remove it from git history, so it is excluded from the first commit on purpose.
CLAUDE.md

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# n8n documentation pages: n8n's content, re-downloaded by scripts/fetch-kb.mjs
kb/pages/

# Labelling page embeds excerpts of n8n pages
labelling/

# Raw run outputs quote whole n8n paragraphs; only the metrics files are committed
results/raw/
