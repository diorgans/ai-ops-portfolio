# Dependencies
node_modules/

# ---------------------------------------------------------------------------
# Secrets — never commit. API keys belong in environment variables or the
# n8n credential store, never in a file here. If one ever lands in the repo,
# rotate it rather than just deleting the file: git keeps history.
# ---------------------------------------------------------------------------
.env
.env.*
.anthropic_key
*.key
*.pem
credentials.json

# n8n local state, if the instance is ever run from inside this folder
.n8n/

# Eval run outputs are COMMITTED deliberately - they are the evidence behind
# the numbers in the README, and a portfolio claim without its raw results is
# just an assertion. They are small and append-only.

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
