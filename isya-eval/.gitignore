dist/

# ---------------------------------------------------------------------------
# Secrets — never commit. Cloudflare Worker secrets live in the dashboard,
# not in this repo. If a key ever lands in a file here, rotate it in the
# Anthropic console rather than just deleting the file: git keeps history.
# ---------------------------------------------------------------------------
.env
.env.*
.dev.vars
.anthropic_key
*.key
*.pem
secrets.json

# Timestamped backups written by save-bot-worker.ps1
*.bak-*

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/

